</DocsFooter>

<style>
    /* Hero — bordered rounded frame with looping video bg + content overlay.
       Copied from the ShellUI docs home. */
    .hero-wrap {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem;
    }
    @@media (min-width: 768px) { .hero-wrap { padding: 1.5rem; } }

    .hero-frame {
        position: relative;
        display: flex;
        min-height: 600px;
        height: 70vh;
        max-height: 900px;
        border: 1px solid var(--border);
        border-radius: 1rem;
        overflow: hidden;
        background: var(--card);
    }

    .hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .hero-video-dark { display: none; }
    :root.dark .hero-video-light { display: none; }
    :root.dark .hero-video-dark { display: block; }

    /* Gradient overlay so the text stays readable over the video */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
            color-mix(in oklch, var(--background) 40%, transparent) 0%,
            color-mix(in oklch, var(--background) 20%, transparent) 40%,
            transparent 100%);
        pointer-events: none;
    }
    :root.dark .hero-overlay {
        background: linear-gradient(135deg,
            color-mix(in oklch, var(--background) 60%, transparent) 0%,
            color-mix(in oklch, var(--background) 30%, transparent) 40%,
            transparent 100%);
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 100%;
        padding: 2rem 1.5rem;
        text-align: center;
        align-items: center;
    }
    @@media (min-width: 768px) {
        .hero-inner {
            padding: 3rem;
            text-align: left;
            align-items: flex-start;
        }
    }

    .hero-inner h1 {
        font-size: 2.25rem;
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.1;
        margin: 0 0 1rem;
        color: var(--foreground);
    }
    @@media (min-width: 1024px) {
        .hero-inner h1 { font-size: 3rem; }
    }
    @@media (min-width: 1280px) {
        .hero-inner h1 { font-size: 3.5rem; }
    }

    .hero-grad { color: var(--primary); }

    .hero-inner p {
        font-size: 1rem;
        color: var(--muted-foreground);
        margin: 0 0 2rem;
        line-height: 1.6;
        max-width: 36rem;
    }
    @@media (min-width: 768px) { .hero-inner p { font-size: 1.125rem; } }

    .hero-actions {
        display: inline-flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.15rem;
        border-radius: 9999px;
        border: 1px solid transparent;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: -0.005em;
        white-space: nowrap;
        transition: background 150ms, border-color 150ms, color 150ms;
    }
    .btn svg { width: 0.9rem; height: 0.9rem; flex-shrink: 0; }
    .btn.primary {
        background: var(--primary);
        color: var(--primary-foreground);
    }
    .btn.primary:hover { background: color-mix(in oklch, var(--primary) 90%, transparent); }

    .btn.ghost {
        background: var(--background);
        color: var(--foreground);
        border-color: var(--border);
    }
    .btn.ghost:hover { background: var(--accent); }

    .features {
        max-width: 1100px; margin: 0 auto;
        padding: 3rem 1.5rem 6rem;
    }
    .features-inner {
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
    }
    @@media (min-width: 640px) { .features-inner { grid-template-columns: repeat(2, 1fr); } }
    @@media (min-width: 900px) { .features-inner { grid-template-columns: repeat(3, 1fr); } }

    .feature {
        padding: 1.5rem;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) + 2px);
        background: var(--card);
        transition: border-color 200ms, transform 200ms;
    }
    .feature:hover { border-color: var(--border-strong); }
    .feature-icon {
        display: inline-flex; align-items: center; justify-content: center;
        width: 2rem; height: 2rem;
        border-radius: calc(var(--radius) - 2px);
        background: var(--accent-soft);
        color: var(--accent);
        margin-bottom: 0.9rem;
    }
    .feature-icon svg { width: 1.125rem; height: 1.125rem; }
    .feature h3 { margin: 0 0 0.35rem; font-size: 0.9375rem; font-weight: 600; letter-spacing: -0.01em; }
    .feature p { margin: 0; color: var(--muted-foreground); font-size: 0.875rem; line-height: 1.55; }
    .feature code {
        font-family: var(--font-mono); font-size: 0.8em;
        background: var(--muted); padding: 0.05rem 0.35rem; border-radius: 4px;
        color: var(--foreground); border: 1px solid var(--border);
    }

    .section-heading { text-align: center; max-width: 44rem; margin: 0 auto 3rem; }
    .section-heading .eyebrow {
        display: inline-block;
        font-size: 0.75rem; letter-spacing: -0.005em;
        color: var(--muted-foreground); font-weight: 500;
        padding: 0.2rem 0.7rem; border: 1px solid var(--border); border-radius: 9999px;
        margin-bottom: 1rem;
    }
    .section-heading h2 {
        font-size: 2rem; font-weight: 700; letter-spacing: -0.025em;
        line-height: 1.15; margin: 0 0 0.75rem;
    }
    .section-heading p {
        margin: 0; color: var(--muted-foreground); font-size: 1rem; line-height: 1.6;
    }
    @@media (min-width: 768px) { .section-heading h2 { font-size: 2.5rem; } }

    /* Showcase — code window + steps */
    .showcase { max-width: 1100px; margin: 0 auto; padding: 5rem 1.5rem; }
    .showcase-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        align-items: start;
    }
    @@media (min-width: 900px) { .showcase-grid { grid-template-columns: 1.15fr 1fr; gap: 3rem; } }

    .code-window {
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) + 4px);
        background: var(--card);
        overflow: hidden;
        box-shadow: 0 12px 40px -12px rgb(0 0 0 / 0.15);
    }
    .code-chrome {
        display: flex; align-items: center; gap: 0.4rem;
        padding: 0.65rem 0.9rem;
        border-bottom: 1px solid var(--border);
        background: color-mix(in oklch, var(--card) 60%, var(--background));
    }
    .code-chrome .dot { width: 0.65rem; height: 0.65rem; border-radius: 9999px; }
    .code-chrome .d-r { background: #ff5f57; }
    .code-chrome .d-y { background: #febc2e; }
    .code-chrome .d-g { background: #28c840; }
    .code-file {
        margin-left: 0.75rem;
        font-family: var(--font-mono); font-size: 0.75rem;
        color: var(--muted-foreground);
    }
    .code-body {
        margin: 0; padding: 1.25rem 1.35rem;
        font-family: var(--font-mono); font-size: 0.8rem;
        line-height: 1.65; color: var(--foreground);
        white-space: pre; overflow-x: auto;
    }
    .code-body .tk-punc { color: var(--muted-foreground); }
    .code-body .tk-key  { color: oklch(0.7 0.15 200); }
    .code-body .tk-str  { color: oklch(0.72 0.16 140); }
    .code-body .tk-num  { color: oklch(0.75 0.16 80); }
    .code-body .tk-hash { color: oklch(0.72 0.19 320); font-weight: 600; }
    .code-body .tk-tag  { color: oklch(0.7 0.18 20); }

    .showcase-notes { display: flex; flex-direction: column; gap: 1.5rem; }
    .showcase-item { display: flex; gap: 1rem; align-items: flex-start; }
    .showcase-num {
        flex-shrink: 0;
        width: 1.75rem; height: 1.75rem;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 9999px;
        background: var(--muted); border: 1px solid var(--border);
        font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600;
        color: var(--foreground);
    }
    .showcase-item h4 { margin: 0 0 0.35rem; font-size: 0.95rem; font-weight: 600; letter-spacing: -0.01em; }
    .showcase-item p { margin: 0; color: var(--muted-foreground); font-size: 0.875rem; line-height: 1.55; }
    .showcase-item code {
        font-family: var(--font-mono); font-size: 0.8em;
        background: var(--muted); padding: 0.05rem 0.35rem; border-radius: 4px;
        border: 1px solid var(--border);
    }

    /* Install steps */
    .install {
        max-width: 1000px; margin: 0 auto;
        padding: 4rem 1.5rem;
        border-top: 1px solid var(--border);
    }
    .install-steps {
        display: grid;
        gap: 0.85rem;
        grid-template-columns: 1fr;
    }
    @@media (min-width: 640px) { .install-steps { grid-template-columns: repeat(2, 1fr); } }

    .install-step {
        display: flex; gap: 0.85rem;
        padding: 1rem 1.15rem;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) + 2px);
        background: var(--card);
        transition: border-color 150ms, background 150ms;
    }
    .install-step:hover { border-color: var(--border-strong); background: var(--muted); }
    .install-num {
        flex-shrink: 0;
        width: 1.75rem; height: 1.75rem;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 6px;
        background: var(--foreground); color: var(--background);
        font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700;
    }
    .install-body { flex: 1; min-width: 0; }
    .install-body h4 { margin: 0 0 0.4rem; font-size: 0.875rem; font-weight: 600; letter-spacing: -0.005em; }
    .mini-code {
        display: flex; gap: 0.5rem; align-items: center;
        font-family: var(--font-mono); font-size: 0.8125rem;
        color: var(--foreground); overflow-x: auto; white-space: nowrap;
    }
    .mini-prompt { color: var(--muted-foreground); user-select: none; }

    /* Primitives grid */
    .primitives { max-width: 1100px; margin: 0 auto; padding: 4rem 1.5rem; border-top: 1px solid var(--border); }
    .prim-grid {
