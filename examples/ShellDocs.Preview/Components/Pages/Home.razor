@page "/"
@layout HomeLayout

<PageTitle>ShellDocs — the docs framework for .NET</PageTitle>

<section class="hero-wrap">
    <div class="hero-frame">
        <video class="hero-video hero-video-light" autoplay loop muted playsinline>
            <source src="/hero-bg-light.webm" type="video/webm" />
        </video>
        <video class="hero-video hero-video-dark" autoplay loop muted playsinline>
            <source src="/hero-bg-dark.webm" type="video/webm" />
        </video>
        <div class="hero-overlay" aria-hidden="true"></div>
        <div class="hero-inner">
            <h1>Docs for your <span class="hero-grad">.NET library.</span></h1>
            <p>Author in markdown, drop Blazor components mid-page, ship one binary. MudBlazor, Radzen, Avalonia — every .NET UI library ends up building the same sidebar, search, and code-block. Now they don't have to.</p>
            <div class="hero-actions">
                <a class="btn primary" href="/docs/introduction">Get started</a>
                <a class="btn ghost" href="https://github.com/shellui-dev/shelldocs" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.58v-2.02c-3.34.72-4.04-1.6-4.04-1.6-.55-1.4-1.35-1.78-1.35-1.78-1.1-.75.08-.74.08-.74 1.22.09 1.86 1.26 1.86 1.26 1.08 1.85 2.84 1.32 3.53 1 .11-.79.42-1.32.77-1.62-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.53.12-3.19 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.89.12 3.19.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3"/></svg>
                    Star on GitHub
                </a>
            </div>
        </div>
    </div>
</section>

<section class="features">
    <div class="section-heading">
        <span class="eyebrow">Why ShellDocs</span>
        <h2>Everything a docs site needs, out of the box</h2>
        <p>Batteries included, but nothing you can't rip out. Every layer is a NuGet package you can swap.</p>
    </div>
    <div class="features-inner">
        <div class="feature">
            <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <h3>Markdown-first</h3>
            <p>Author in familiar .md files with YAML frontmatter. File-based routing over <code>content/</code>.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18M3 9h18"/></svg>
            </div>
            <h3>Live Razor components</h3>
            <p>Drop <code>&lt;Button /&gt;</code> mid-markdown. Registered components render as real Blazor — no iframes.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
            </div>
            <h3>⌘K search</h3>
            <p>Build-time client-side search index. Zero backend, works offline, sub-millisecond queries.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            </div>
            <h3>Themeable</h3>
            <p>Ships shadcn / fuma / nextra presets. Every token is a CSS variable — override any of them, live.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h3>Static or server</h3>
            <p><code>shelldocs build</code> emits Blazor WASM static output for GitHub Pages, Cloudflare Pages, S3. Or run Server mode on Azure, Fly.io, or a container host.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M7 11l5 5 5-5M12 4v12"/></svg>
            </div>
            <h3>CLI-driven</h3>
            <p><code>shelldocs init</code>, <code>new</code>, <code>dev</code>, <code>build</code>. Same feel as <code>shellui</code>, same install-and-go DX.</p>
        </div>
    </div>
</section>

<section class="showcase">
    <div class="section-heading">
        <span class="eyebrow">Zero-config</span>
        <h2>Write markdown. Ship docs.</h2>
        <p>Frontmatter for metadata. Blazor components inline. A CLI that scaffolds everything.</p>
    </div>
    <div class="showcase-grid">
        <div class="code-window">
            <div class="code-chrome">
                <span class="dot d-r"></span><span class="dot d-y"></span><span class="dot d-g"></span>
                <span class="code-file">content/docs/introduction.md</span>
            </div>
<pre class="code-body"><span class="tk-punc">---</span>
<span class="tk-key">title</span><span class="tk-punc">:</span> <span class="tk-str">Introduction</span>
<span class="tk-key">description</span><span class="tk-punc">:</span> <span class="tk-str">Get up and running with ShellDocs.</span>
<span class="tk-key">order</span><span class="tk-punc">:</span> <span class="tk-num">1</span>
<span class="tk-punc">---</span>

<span class="tk-hash"># Introduction</span>

ShellDocs is a Blazor-native docs framework in the
tradition of fumadocs and Nextra.

<span class="tk-tag">&lt;Callout Variant=<span class="tk-str">"info"</span>&gt;</span>
Works in Server, WASM, and static output.
<span class="tk-tag">&lt;/Callout&gt;</span>

<span class="tk-punc">```</span><span class="tk-key">razor:preview</span>
<span class="tk-tag">&lt;Button Variant=<span class="tk-str">"outline"</span>&gt;</span>Click me<span class="tk-tag">&lt;/Button&gt;</span>
<span class="tk-punc">```</span></pre>
        </div>
        <div class="showcase-notes">
            <div class="showcase-item">
                <span class="showcase-num">1</span>
                <div>
                    <h4>Frontmatter for metadata</h4>
                    <p>Order pages in the sidebar, set descriptions for search results, tag with a category. All the metadata lives at the top of the file.</p>
                </div>
            </div>
            <div class="showcase-item">
                <span class="showcase-num">2</span>
                <div>
                    <h4>Components inline</h4>
                    <p>Reference any registered Blazor component with a self-closing tag mid-markdown. Renders live — no iframes, no MDX preprocessor.</p>
                </div>
            </div>
            <div class="showcase-item">
                <span class="showcase-num">3</span>
                <div>
                    <h4>Live previews from code fences</h4>
                    <p>Fence with <code>razor:preview</code> and readers get a rendered demo plus the source, tabbed and copyable.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="install">
    <div class="section-heading">
        <span class="eyebrow">Get started</span>
        <h2>One command to scaffold, one to serve</h2>
        <p>No config, no build step, no lock file. Just a Blazor project with docs.</p>
    </div>
    <div class="install-steps">
        <div class="install-step">
            <div class="install-num">1</div>
            <div class="install-body">
                <h4>Install the CLI</h4>
                <div class="mini-code"><span class="mini-prompt">$</span><span>dotnet tool install -g ShellDocs.CLI</span></div>
            </div>
        </div>
        <div class="install-step">
            <div class="install-num">2</div>
            <div class="install-body">
                <h4>Scaffold a docs project</h4>
                <div class="mini-code"><span class="mini-prompt">$</span><span>shelldocs init my-docs &amp;&amp; cd my-docs</span></div>
            </div>
        </div>
        <div class="install-step">
            <div class="install-num">3</div>
            <div class="install-body">
                <h4>Start the dev server</h4>
                <div class="mini-code"><span class="mini-prompt">$</span><span>shelldocs dev</span></div>
            </div>
        </div>
        <div class="install-step">
            <div class="install-num">4</div>
            <div class="install-body">
                <h4>Build for production</h4>
                <div class="mini-code"><span class="mini-prompt">$</span><span>shelldocs build --output ./dist</span></div>
            </div>
        </div>
    </div>
</section>

<section class="primitives">
    <div class="section-heading">
        <span class="eyebrow">Primitives</span>
        <h2>Ready-made pieces</h2>
        <p>The pattern every good docs site uses — assembled, themed, keyboard-accessible.</p>
    </div>
    <div class="prim-grid">
        <a class="prim" href="/docs/components/callout"><span class="prim-key">Callout</span><span class="prim-desc">Info / warning / tip / danger boxes with icons</span></a>
        <a class="prim" href="/docs/components/code-block"><span class="prim-key">CodeBlock</span><span class="prim-desc">Syntax-highlighted fences with copy button + filename tab</span></a>
        <a class="prim" href="/docs/components/tabs"><span class="prim-key">Tabs</span><span class="prim-desc">Keyboard-nav tabs with sync groups across the page</span></a>
        <a class="prim" href="/docs/markdown-syntax"><span class="prim-key">SearchDialog</span><span class="prim-desc">⌘K palette with sub-ms client-side ranking</span></a>
        <a class="prim" href="/docs/introduction"><span class="prim-key">TableOfContents</span><span class="prim-desc">Right-rail nav with smooth scroll-tracked highlight</span></a>
        <a class="prim" href="/docs/introduction"><span class="prim-key">PrevNextNav</span><span class="prim-desc">Auto-derived pagination from your navigation graph</span></a>
        <a class="prim" href="/docs/introduction"><span class="prim-key">Breadcrumb</span><span class="prim-desc">Path-aware breadcrumbs for nested doc sections</span></a>
        <a class="prim" href="/docs/theming"><span class="prim-key">TypeTable</span><span class="prim-desc">API reference tables — hand-authored or XML-doc driven</span></a>
    </div>
</section>

<section class="cta">
    <div class="cta-inner">
        <h2>Built by the ShellUI team.</h2>
        <p>Same taste, same craftsmanship, same install-and-go DX. Free forever, MIT-licensed, community-driven.</p>
        <div class="hero-actions">
            <a class="btn primary" href="/docs/introduction">
                <span>Read the docs</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a class="btn ghost" href="https://github.com/shellui-dev/shelldocs" target="_blank" rel="noopener">Contribute on GitHub</a>
        </div>
    </div>
</section>

<DocsFooter Version="0.1.0-alpha" TwitterHandle="shellui_">
    <Columns>
        <div class="docs-footer-col">
            <h3>Resources</h3>
            <ul>
                <li><a href="/docs/introduction">Documentation</a></li>
                <li><a href="/showcase">Showcase</a></li>
                <li><a href="/blog">Blog</a></li>
            </ul>
        </div>
        <div class="docs-footer-col">
            <h3>Support</h3>
            <ul>
                <li><a href="https://github.com/shellui-dev/shelldocs/issues" target="_blank" rel="noopener">Request feature</a></li>
                <li><a href="https://github.com/shellui-dev/shelldocs/issues" target="_blank" rel="noopener">Report bug</a></li>
