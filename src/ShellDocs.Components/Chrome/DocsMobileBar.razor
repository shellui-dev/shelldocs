@using ShellIcons.Icons
@inject IJSRuntime JS

<div class="docs-mobile-bar" role="toolbar" aria-label="Mobile toolbar">
    <button type="button" class="docs-mobile-tool" data-mobile-nav-toggle aria-expanded="false" aria-label="Toggle navigation">
        <Menu Class="mobile-nav-icon-open" />
        <X Class="mobile-nav-icon-close" />
    </button>

    <button type="button" class="docs-mobile-tool" @onclick="OpenSearch" aria-label="Search">
        <Search />
    </button>

    <ThemeToggle />
</div>

@code {
    private Task OpenSearch() => JS.InvokeVoidAsync("shelldocsSearch.open").AsTask();
}
