@inject NavigationManager Nav
@inject ShellDocsOptions Options
@inject DocsVersionResolver Versions
@implements IDisposable

@* Same contract as PackageSelector: shelldocs.js opens/closes it, and the
   options are hrefs computed at render time, so it works on static hosts. *@
@if (Options.Versions.Count > 1)
{
    var path = DocsVersionResolver.PathOf(Nav);
    var current = Versions.Current(path)!;
    <div class="ver ver-@Placement" data-open="false">
        <button type="button" class="ver-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Docs version: @current.Label">
            <span class="ver-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="@TagIcon"/></svg>
            </span>
            <span class="ver-value">@current.Label</span>
            <svg class="ver-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </button>

        <div class="ver-menu" role="listbox">
            @foreach (var v in Options.Versions)
            {
                var isSel = v.Id == current.Id;
                <a class="ver-option @(isSel ? "selected" : "")" role="option" aria-selected="@(isSel ? "true" : "false")" href="@Versions.GetVersionHref(path, v)">
                    <span class="ver-option-body">
                        <span class="ver-option-title">
                            @v.Label
                            @if (v.IsLatest)
                            {
                                <span class="ver-badge">latest</span>
                            }
                        </span>
                        @if (!string.IsNullOrEmpty(v.Description))
                        {
                            <span class="ver-option-desc">@v.Description</span>
                        }
                    </span>
                    @if (isSel)
                    {
                        <svg class="ver-option-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    }
                </a>
            }
        </div>
    </div>
}

@code {
    // "sidebar", "header" (TopNav, desktop only) or "drawer" (mobile-only copy
    // used when the header carries the desktop one).
    [Parameter] public string Placement { get; set; } = "sidebar";

    private const string TagIcon = "M12 2H2v10l9.29 9.29a1 1 0 0 0 1.41 0l8.59-8.59a1 1 0 0 0 0-1.41z M7 7h.01";

    // No parameters change on navigation, so the parent's re-render would skip us.
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
