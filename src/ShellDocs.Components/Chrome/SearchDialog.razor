@using ShellIcons.Icons

@* A template: shelldocs.js clones it onto <body> to open search, ranks
   /_shelldocs/search.json in the browser and clones a [data-search-row] per result,
   so search works without a Blazor runtime. *@
<div class="search-backdrop" data-search-dialog hidden role="dialog" aria-modal="true" aria-label="Search docs">
    <div class="search-panel">
        <div class="search-input-row">
            <Search Class="search-icon" />
            <input type="text"
                   class="search-input"
                   data-search-input
                   placeholder="Search docs…"
                   aria-label="Search docs"
                   autocomplete="off"
                   spellcheck="false" />
            <kbd class="search-esc">Esc</kbd>
        </div>

        <div class="search-results" data-search-results role="listbox" aria-label="Results"></div>

        <div class="search-footer">
            <span class="search-hint">
                <kbd class="kbd-icon"><ArrowUp /></kbd>
                <kbd class="kbd-icon"><ArrowDown /></kbd>
                navigate
            </span>
            <span class="search-hint">
                <kbd class="kbd-icon"><CornerDownLeft /></kbd>
                open
            </span>
            <span class="search-hint"><kbd>Esc</kbd> close</span>
        </div>
    </div>

    <div hidden data-search-rows>
        <a class="search-result" data-search-row="p" role="option" tabindex="-1">
            <span class="search-result-kind"><File StrokeWidth="1.75" /></span>
            <span class="search-result-body">
                <span class="search-result-title"></span>
                <span class="search-result-section"></span>
                <span class="search-result-snippet"></span>
            </span>
        </a>
        <a class="search-result" data-search-row="h" role="option" tabindex="-1">
            <span class="search-result-kind"><Hash StrokeWidth="1.75" /></span>
            <span class="search-result-body">
                <span class="search-result-title"></span>
                <span class="search-result-section"></span>
                <span class="search-result-snippet"></span>
            </span>
        </a>
        <div class="search-empty" data-search-row="empty"></div>
    </div>
</div>
