@using ShellIcons.Icons
@inject ShellDocsOptions Options
@inject IJSRuntime JS

<header class="docs-header">
    <div class="docs-header-inner">
        @* shelldocs.js toggles [data-mobile-open] on the page shell: DocsLayout slides
           in the sidebar, HomeLayout (MobileMenu) shows the menu below. *@
        <button type="button" class="docs-header-hamburger" data-mobile-nav-toggle aria-expanded="false" aria-label="Toggle navigation">
            <Menu Class="mobile-nav-icon-open" />
            <X Class="mobile-nav-icon-close" />
        </button>
        <a class="docs-header-brand" href="/">
            <BrandLogo />
            <span class="docs-header-brand-name">@(!string.IsNullOrEmpty(Options.SiteName) ? Options.SiteName : "Docs")</span>
        </a>

        <nav class="docs-header-nav" aria-label="Primary">
            @foreach (var link in Options.PrimaryNav)
            {
                if (link.Children is { Count: > 0 })
                {
                    <div class="docs-header-nav-item has-menu">
                        <button type="button" class="docs-header-nav-link">
                            @link.Label
                            <ChevronDown Class="chevron" />
                        </button>
                        <div class="docs-header-mega">
                            <div class="docs-header-mega-grid">
                                @foreach (var child in link.Children)
                                {
                                    <a class="docs-header-mega-card" href="@child.Href">
                                        <span class="docs-header-mega-icon">
                                            @if (child.IconSvg is not null)
                                            {
                                                @((MarkupString)child.IconSvg)
                                            }
                                            else
                                            {
                                                <Square StrokeWidth="1.75" />
                                            }
                                        </span>
                                        <span class="docs-header-mega-body">
                                            <span class="docs-header-mega-title">@child.Label</span>
                                            @if (!string.IsNullOrEmpty(child.Description))
                                            {
                                                <span class="docs-header-mega-desc">@child.Description</span>
                                            }
                                        </span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a class="docs-header-nav-link" href="@link.Href">@link.Label</a>
                }
            }
        </nav>

        <div class="docs-header-actions">
            @if (ShowVersionSelector)
            {
                <VersionSelector Placement="header" />
            }
            @if (ShowSearch)
            {
                <button type="button" class="docs-header-search" @onclick="OpenSearch" aria-label="Search">
                    <Search />
                    <span class="docs-header-search-label">Search</span>
                    <span class="docs-header-kbd">
                        <kbd>Ctrl</kbd>
                        <kbd>K</kbd>
                    </span>
                </button>
            }

            <ThemeToggle />

            @if (!string.IsNullOrEmpty(Options.GitHubRepo))
            {
                <a class="docs-header-icon-link" href="https://github.com/@Options.GitHubRepo" target="_blank" rel="noopener" aria-label="GitHub">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.58v-2.02c-3.34.72-4.04-1.6-4.04-1.6-.55-1.4-1.35-1.78-1.35-1.78-1.1-.75.08-.74.08-.74 1.22.09 1.86 1.26 1.86 1.26 1.08 1.85 2.84 1.32 3.53 1 .11-.79.42-1.32.77-1.62-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.53.12-3.19 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.89.12 3.19.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3"/></svg>
                </a>
            }
        </div>
    </div>
    @if (MobileMenu && Options.PrimaryNav.Count > 0)
    {
        <nav class="docs-header-mobile-menu" aria-label="Primary">
            @foreach (var link in Options.PrimaryNav)
            {
                if (link.Children is { Count: > 0 })
                {
                    <div class="docs-header-mobile-group">@link.Label</div>
                    @foreach (var child in link.Children)
                    {
                        <a class="docs-header-mobile-link nested" href="@child.Href">@child.Label</a>
                    }
                }
                else
                {
                    <a class="docs-header-mobile-link" href="@link.Href">@link.Label</a>
                }
            }
        </nav>
    }
</header>

@code {
    // HomeLayout hides search and the version selector on marketing pages.
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public bool ShowVersionSelector { get; set; } = true;
    // Layouts without a sidebar drawer render the primary nav as a mobile menu.
    [Parameter] public bool MobileMenu { get; set; }
    private Task OpenSearch() => JS.InvokeVoidAsync("shelldocsSearch.open").AsTask();
}
