@using ShellIcons.Icons
@inject NavigationManager Nav
@inject ShellDocsOptions Options
@inject DocsVersionResolver Versions
@implements IDisposable

@* Open/close is handled by shelldocs.js via [data-open]; the menu is always
   rendered and hidden by CSS, and options are plain links. *@
@if (Options.Packages.Count > 1)
{
    var path = DocsVersionResolver.PathOf(Nav);
    var version = Versions.Current(path);
    var selected = Versions.SelectPackage(path) ?? Options.Packages[0];
    <div class="pkg" data-open="false">
        <button type="button" class="pkg-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="pkg-mark">
                @if (selected.IconPath is { } markPath)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="@markPath"/></svg>
                }
                else
                {
                    <Box StrokeWidth="1.75" />
                }
            </span>
            <span class="pkg-value">@selected.Title</span>
            <ChevronDown Class="pkg-chevron" />
        </button>

        <div class="pkg-menu" role="listbox">
            @foreach (var pkg in Options.Packages)
            {
                var isSel = pkg.Id == selected.Id;
                <a class="pkg-option @(isSel ? "selected" : "")" role="option" aria-selected="@(isSel ? "true" : "false")" href="@Versions.GetPackageHref(pkg, version)">
                    <span class="pkg-option-icon">
                        @if (pkg.IconPath is { } optionPath)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="@optionPath"/></svg>
                        }
                        else
                        {
                            <Box StrokeWidth="1.75" />
                        }
                    </span>
                    <span class="pkg-option-body">
                        <span class="pkg-option-title">@pkg.Title</span>
                        <span class="pkg-option-desc">@pkg.Description</span>
                    </span>
                    @if (isSel)
                    {
                        <Check Class="pkg-option-check" StrokeWidth="2.5" />
                    }
                </a>
            }
        </div>
    </div>
}

@code {
    // No parameters change on navigation, so the parent's re-render would skip us.
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
