@inherits LayoutComponentBase
@inject ShellDocsOptions Options

<div class="home-shell">
    <DocsHeader />
    <main class="home-main">
        @Body
    </main>

    <footer class="home-footer">
        <div class="home-footer-inner">
            <div class="home-footer-brand">
                <div class="home-footer-mark">
                    <span class="home-footer-logo-dot"></span>
                    <span class="home-footer-brand-name">@(!string.IsNullOrEmpty(Options.SiteName) ? Options.SiteName : "ShellDocs")</span>
                </div>
                @if (!string.IsNullOrEmpty(Options.SiteTagline))
                {
                    <p class="home-footer-tagline">@Options.SiteTagline</p>
                }
                <span class="home-footer-version">0.1.0-alpha</span>
                <div class="home-footer-socials">
                    @if (!string.IsNullOrEmpty(Options.GitHubRepo))
                    {
                        <a href="https://github.com/@Options.GitHubRepo" target="_blank" rel="noopener" aria-label="GitHub">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.58v-2.02c-3.34.72-4.04-1.6-4.04-1.6-.55-1.4-1.35-1.78-1.35-1.78-1.1-.75.08-.74.08-.74 1.22.09 1.86 1.26 1.86 1.26 1.08 1.85 2.84 1.32 3.53 1 .11-.79.42-1.32.77-1.62-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.53.12-3.19 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.89.12 3.19.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3"/></svg>
                        </a>
                    }
                    <a href="https://x.com/shellui_" target="_blank" rel="noopener" aria-label="X">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>
                </div>
            </div>

            <div class="home-footer-col">
                <h3>Resources</h3>
                <ul>
                    <li><a href="/docs/introduction">Documentation</a></li>
                    <li><a href="/showcase">Showcase</a></li>
                    <li><a href="/blog">Blog</a></li>
                </ul>
            </div>

            <div class="home-footer-col">
                <h3>Support</h3>
                <ul>
                    @if (!string.IsNullOrEmpty(Options.GitHubRepo))
                    {
                        <li><a href="https://github.com/@(Options.GitHubRepo)/issues" target="_blank" rel="noopener">Request feature</a></li>
                        <li><a href="https://github.com/@(Options.GitHubRepo)/issues" target="_blank" rel="noopener">Report bug</a></li>
                    }
                    <li><a href="/sponsors">Sponsor</a></li>
                </ul>
            </div>
        </div>
    </footer>
</div>
