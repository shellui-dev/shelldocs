@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ShellDocs.Components.Chrome.MobileNavState MobileNav
@inject ShellDocs.Components.Chrome.SidebarCollapseState Collapse
@inject ShellDocsOptions Options
@inject IJSRuntime JS
@implements IDisposable
@using Microsoft.AspNetCore.Components.Sections

<div class="docs-shell docs-shell-@Variant @(Collapse.IsCollapsed ? "docs-sidebar-collapsed" : "")" data-mobile-open="@MobileNav.IsOpen">
    @if (Options.LayoutVariant == DocsLayoutVariant.TopNav)
    {
        <DocsHeader />
    }
    else
    {
        <DocsMobileBar />
    }

    @if (Options.LayoutVariant == DocsLayoutVariant.Sidebar && Collapse.IsCollapsed)
    {
        <div class="docs-collapsed-toolbar">
            <button type="button" class="docs-collapsed-tool" @onclick="Collapse.Toggle" aria-label="Expand sidebar" title="Expand sidebar">
                <ShellIcons.Icons.PanelLeft StrokeWidth="1.75" />
            </button>
            <button type="button" class="docs-collapsed-tool" @onclick="OpenSearch" aria-label="Search" title="Search (⌘K)">
                <ShellIcons.Icons.Search />
            </button>
        </div>
    }

    <div class="docs-body">
        <aside class="docs-sidebar-slot @(MobileNav.IsOpen ? "open" : "")" aria-label="Sidebar">
            @if (Options.LayoutVariant == DocsLayoutVariant.Sidebar)
            {
                <DocsSidebarHeader />
            }
            <DocsSidebar />
        </aside>
        @if (MobileNav.IsOpen)
        {
            <button type="button" class="docs-sidebar-backdrop" @onclick="MobileNav.Close" aria-label="Close navigation"></button>
        }
        <main class="docs-main">
            <div class="docs-content">
                <DocsBreadcrumb />
                @Body
                <PrevNextNav />
            </div>
        </main>
        <aside class="docs-toc-slot" aria-label="On this page">
            <TableOfContents />
        </aside>
    </div>
</div>

<SearchDialog />

@code {
    private string Variant => Options.LayoutVariant switch
    {
        DocsLayoutVariant.Sidebar => "sidebar",
        _ => "topnav"
    };

    protected override void OnInitialized()
    {
        MobileNav.OnChange += StateHasChanged;
        Collapse.OnChange  += StateHasChanged;
        Nav.LocationChanged += OnRouteChanged;
    }

    private void OnRouteChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => MobileNav.Close();

    private Task OpenSearch() => JS.InvokeVoidAsync("shelldocsSearch.open").AsTask();

    public void Dispose()
    {
        MobileNav.OnChange -= StateHasChanged;
        Collapse.OnChange  -= StateHasChanged;
        Nav.LocationChanged -= OnRouteChanged;
    }
}
