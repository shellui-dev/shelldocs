@using ShellDocs.Markdown
@using ShellIcons.Icons
@attribute [ShellDocsIgnore]
@inject MarkdownRenderer Renderer
@inject ShellDocsOptions Options
@inject NavigationManager Nav
@inject ILogger<PreviewFrame> Logger

@* Tabs, copy and the ⋯ menu are driven by shelldocs.js through data-* attributes,
   so they work without a Blazor runtime. Both panels are always rendered; CSS
   shows the one named by [data-preview-tab]. Fed either a PreviewSlot
   (razor:preview fence) or Content + Code (DemoPreview, ComponentPreview). *@
@* not-prose: page typography stays out of live examples. *@
<div class="preview-frame not-prose" id="@Id" data-preview-tab="preview">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="preview-title">@Title</div>
    }
    <div class="preview-toolbar">
        <div class="preview-tabs" role="tablist" aria-label="Example view">
            <button type="button" role="tab" class="preview-tab" id="@PartId("tab-preview")" aria-controls="@PartId("panel-preview")"
                    data-preview-tab-target="preview" aria-selected="true" tabindex="0">
                <Eye />
                <span>Preview</span>
            </button>
            @if (_hasCode)
            {
                <button type="button" role="tab" class="preview-tab" id="@PartId("tab-code")" aria-controls="@PartId("panel-code")"
                        data-preview-tab-target="code" aria-selected="false" tabindex="-1">
                    <CodeXml />
                    <span>Code</span>
                </button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_caption))
        {
            <div class="preview-caption" title="@_caption">@_caption</div>
        }
        <div class="preview-actions">
            @if (_hasCode)
            {
                <button type="button" class="preview-action preview-copy" data-preview-copy aria-label="Copy code" title="Copy code">
                    <Copy Class="icon-copy" />
                    <Check Class="icon-check" />
                </button>
            }
            <div class="preview-menu" data-open="false">
                <button type="button" class="preview-action preview-menu-trigger" aria-haspopup="menu" aria-expanded="false" aria-label="More actions" title="More actions">
                    <EllipsisVertical />
                </button>
                <div class="preview-menu-list" role="menu">
                    <a class="preview-menu-item" role="menuitem" href="@_openHref" target="_blank" rel="noopener">
                        <ExternalLink />
                        <span>Open in new tab</span>
                    </a>
                    @if (_bugHref is not null)
                    {
                        <div class="preview-menu-separator" role="separator"></div>
                        <a class="preview-menu-item" role="menuitem" href="@_bugHref" target="_blank" rel="noopener">
                            <Bug />
                            <span>Report a bug</span>
                        </a>
                        <a class="preview-menu-item" role="menuitem" href="@_suggestHref" target="_blank" rel="noopener">
                            <Lightbulb />
                            <span>Suggest something</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="preview-panel preview-render" role="tabpanel" id="@PartId("panel-preview")" aria-labelledby="@PartId("tab-preview")" data-preview-panel="preview" data-layout="@_layout">
        @if (ErrorMessage is not null)
        {
            <div class="preview-error" role="alert">
                <TriangleAlert Class="preview-error-icon" />
                <div class="preview-error-body">
                    <div class="preview-error-title">@ErrorTitle</div>
                    <div class="preview-error-message">@ErrorMessage</div>
                </div>
            </div>
        }
        else if (Content is not null)
        {
            @Content
        }
        else if (Preview!.Nodes is { Count: > 0 } nodes)
        {
            @SlotRenderer.RenderNodes(Renderer, nodes, Logger)
        }
        else
        {
            @SlotRenderer.Component(Renderer, Preview!.ComponentType!, Preview!.Parameters, Preview!.ChildContentRaw, Logger, razorChildren: true)
        }
    </div>
    @if (_hasCode)
    {
        <div class="preview-panel preview-code-panel" role="tabpanel" id="@PartId("panel-code")" aria-labelledby="@PartId("tab-code")" data-preview-panel="code">
            @if (CodeTabs is { Count: > 0 } tabs)
            {
                @* Same [data-tabs] contract as <CodeGroup>; data-tabs-missing shows the note
                   below when the synced choice (e.g. from the page switch) isn't one of these tabs. *@
                <div class="preview-code-variants" id="@PartId("code")" data-tabs data-tabs-missing data-tabs-value="@tabs[0].Label" data-tabs-sync="@SyncKey">
                    <div class="preview-code-tabs" role="tablist" aria-label="Code">
                        @for (var i = 0; i < tabs.Count; i++)
                        {
                            var tab = tabs[i];
                            <button type="button" role="tab" class="preview-code-tab"
                                    id="@PartId($"code-tab-{i}")" aria-controls="@PartId($"code-panel-{i}")"
                                    aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? "0" : "-1")"
                                    data-tab-target="@tab.Label">@tab.Label</button>
                        }
                    </div>
                    @* Panels share one grid cell, so switching (or the missing note) never changes the height. *@
                    <div class="preview-code-stack">
                        @for (var i = 0; i < tabs.Count; i++)
                        {
                            var tab = tabs[i];
                            <div class="preview-code-variant" role="tabpanel" id="@PartId($"code-panel-{i}")" aria-labelledby="@PartId($"code-tab-{i}")"
                                 data-tab-panel="@tab.Label" hidden="@(i != 0)">
                                <pre class="preview-code language-@tab.Language"><code class="language-@tab.Language">@tab.Code</code></pre>
                            </div>
                        }
                        <div class="preview-code-variant preview-code-missing" data-tab-missing hidden>
                            @* String expressions keep the spaces Razor would trim around the span. *@
                            @("Not available on ")<span data-tab-missing-label></span>@(" yet")
                        </div>
                    </div>
                </div>
            }
            else
            {
                <pre class="preview-code language-@Language"><code class="language-@Language">@(Code ?? Preview?.Code)</code></pre>
            }
        </div>
    }
</div>

@code {
    [Parameter] public PreviewSlot? Preview { get; set; }

    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public string Language { get; set; } = "razor";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string ErrorTitle { get; set; } = "razor:preview error";
    // "center" (default) centres the example; "stretch" lets block-level
    // components (charts, inputs, tables) fill the frame's width; "scroll" lets an
    // example wider than the frame (pagination, toolbars) scroll inside it.
    [Parameter] public string? Layout { get; set; }

    // Must be deterministic: it's the anchor, and how shelldocs.js restores the
    // selected tab when Blazor replaces the prerendered DOM.
    [Parameter] public string? Id { get; set; }
    // Used in issue titles; defaults to the previewed component's type name.
    [Parameter] public string? Name { get; set; }
    // Replace the Code panel's single source with tabs (MAUI, Avalonia, …).
    [Parameter] public IReadOnlyList<PreviewCodeTab>? CodeTabs { get; set; }
    // Code tabs with the same key switch together site-wide, like <CodeGroup SyncKey>.
    [Parameter] public string? SyncKey { get; set; }
    // Short muted note in the toolbar; defaults to ShellDocsOptions.PreviewCaption.
    [Parameter] public string? Caption { get; set; }
    // "Open in new tab" target; defaults to this example's anchor on the page.
    [Parameter] public string? OpenHref { get; set; }

    private string _openHref = "";
    private string _layout = "center";
    private string? _caption;
    private bool _hasCode;
    private string? _bugHref;
    private string? _suggestHref;

    private string? ErrorMessage =>
        Error
        ?? (Content is null && Preview?.ComponentType is null ? Preview?.Error ?? "Unknown error." : null);

    private string? PartId(string part) => Id is null ? null : $"{Id}-{part}";

    protected override void OnParametersSet()
    {
        _layout = (Layout ?? Preview?.Layout)?.ToLowerInvariant() switch
        {
            "stretch" => "stretch",
            "scroll" => "scroll",
            _ => "center",
        };
        _caption = Caption ?? Options.PreviewCaption;
        _hasCode = CodeTabs is { Count: > 0 } || !string.IsNullOrEmpty(Code ?? Preview?.Code);
        var path = DocsVersionResolver.PathOf(Nav);
        _openHref = OpenHref ?? (string.IsNullOrEmpty(Id) ? path : $"{path}#{Id}");

        var tracker = PreviewLinks.IssueTracker(Options);
        if (tracker is null)
        {
            _bugHref = _suggestHref = null;
            return;
        }
        var name = Name ?? (Preview?.ComponentType is { } t ? GenericComponents.TagName(t) : null) ?? Title ?? "docs";
        var pageUrl = PreviewLinks.PageUrl(Options, path, Id);
        _bugHref = PreviewLinks.BugReport(tracker, name, pageUrl);
        _suggestHref = PreviewLinks.Suggestion(tracker, name, pageUrl);
    }
}
