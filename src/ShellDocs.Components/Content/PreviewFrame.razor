@using ShellIcons.Icons
@using ShellDocs.Markdown
@attribute [ShellDocsIgnore]
@inject MarkdownRenderer Renderer
@inject ILogger<PreviewFrame> Logger

@* Expand/collapse and copy are handled by shelldocs.js (data-preview-*).
   Fed either a PreviewSlot (razor:preview fence) or Content + Code (DemoPreview). *@
<div class="preview-frame collapsed">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="preview-title">@Title</div>
    }
    <div class="preview-render">
        @if (ErrorMessage is not null)
        {
            <div class="preview-error" role="alert">
                <TriangleAlert Class="preview-error-icon" />
                <div class="preview-error-body">
                    <div class="preview-error-title">@ErrorTitle</div>
                    <div class="preview-error-message">@ErrorMessage</div>
                </div>
            </div>
        }
        else if (Content is not null)
        {
            @Content
        }
        else if (Preview!.Nodes is { Count: > 0 } nodes)
        {
            @* Every top-level sibling of the fence, in order. *@
            @SlotRenderer.RenderNodes(Renderer, nodes, Logger)
        }
        else
        {
            <DynamicComponent Type="Preview!.ComponentType"
                              Parameters="BuildParameters(Preview!.Parameters, Preview!.ChildContentRaw)" />
        }
    </div>
    <div class="preview-code-wrap">
        <pre class="preview-code language-@Language"><code class="language-@Language">@(Code ?? Preview?.Code)</code></pre>
        <div class="preview-fade">
            <button type="button" class="preview-expand" data-preview-toggle="expand">View Code</button>
        </div>
        <div class="preview-code-actions">
            <button type="button" class="preview-copy" data-preview-copy aria-label="Copy code">
                <Copy Class="icon-copy" />
                <Check Class="icon-check" />
            </button>
            <button type="button" class="preview-collapse" data-preview-toggle="collapse">Collapse</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public PreviewSlot? Preview { get; set; }

    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public string Language { get; set; } = "razor";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string ErrorTitle { get; set; } = "razor:preview error";

    private string? ErrorMessage =>
        Error
        ?? (Content is null && Preview?.ComponentType is null ? Preview?.Error ?? "Unknown error." : null);

    // Only reached when ErrorMessage is null, i.e. ComponentType is non-null.
    private IDictionary<string, object> BuildParameters(IReadOnlyDictionary<string, string> attrs, string? childContentRaw) =>
        SlotRenderer.BuildParameters(Renderer, Preview!.ComponentType!, attrs, childContentRaw, Logger);
}
