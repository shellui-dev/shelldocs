@using ShellIcons.Icons
@namespace ShellDocs.Components.Content

<li class="filetree-item @(IsFolder ? "is-folder" : "is-file") @(Highlight ? "highlight" : "")">
    <span class="filetree-glyph" aria-hidden="true">
        @if (IsFolder)
        {
            <Folder StrokeWidth="1.75" />
        }
        else
        {
            <File StrokeWidth="1.75" />
        }
    </span>
    <span class="filetree-label">@Name</span>
    @if (!string.IsNullOrEmpty(Comment))
    {
        <span class="filetree-comment">@Comment</span>
    }
    @if (IsFolder && ChildContent is not null)
    {
        <ul class="filetree-list">
            @ChildContent
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public bool IsFolder { get; set; }
    [Parameter] public string? Comment { get; set; }
    [Parameter] public bool Highlight { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
