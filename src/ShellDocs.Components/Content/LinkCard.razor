@using ShellIcons.Icons
@namespace ShellDocs.Components.Content

<a class="link-card" href="@Href" target="@(External ? "_blank" : null)" rel="@(External ? "noopener" : null)">
    <div class="link-card-body">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="link-card-title">@Title</div>
        }
        @if (!string.IsNullOrEmpty(Description))
        {
            <div class="link-card-desc">@Description</div>
        }
    </div>
    <span class="link-card-arrow">
        <ArrowRight />
    </span>
</a>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter, EditorRequired] public string Href { get; set; } = "#";
    [Parameter] public bool External { get; set; }
}
